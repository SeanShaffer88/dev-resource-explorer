{
  "name": "dev-resource-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A fast, accessible explorer for Sean Shaffer's development resource catalog.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test",
    "test:browser": "playwright test",
    "test:browser:report": "playwright show-report",
    "check": "node scripts/check.mjs",
    "sync": "node scripts/sync-catalog.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1"
  }
}
